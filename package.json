{
  "name": "picyboo-token-bridge",
  "version": "0.2.0",
  "description": "PICYBOO™ reference token bridging toolbox with modular CLI and SDK.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "pbbridge": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "lint": "tsc -p tsconfig.app.json --noEmit",
    "start": "node dist/bin/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "keywords": [
    "picyboo",
    "token",
    "bridge",
    "base58",
    "base64",
    "hex",
    "cli"
  ],
  "dependencies": {
    "bs58": "^6.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^1.4.0"
  }
}
